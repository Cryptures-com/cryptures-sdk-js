{
  "name": "@cryptures.com/sdk",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Official JavaScript/TypeScript SDK for the Cryptures API: blockchain infrastructure, crypto cards, and compliance in one client.",
  "license": "MIT",
  "author": "Cryptures.com",
  "homepage": "https://cryptures.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cryptures-com/cryptures-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/Cryptures-com/cryptures-sdk-js/issues"
  },
  "keywords": [
    "cryptures",
    "blockchain",
    "crypto",
    "api",
    "sdk",
    "wallet",
    "compliance",
    "kyc",
    "aml",
    "cards"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
